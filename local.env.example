# Copy to local.env (gitignored) and fill in.
# `set -a && source local.env && set +a` before running the server.

# Tuya Cloud OpenAPI credentials.
# Get from https://iot.tuya.com -> Cloud -> Development -> create a project.
# Leave blank if you only use the LAN protocol.
TUYA_CLOUD_ACCESS_ID=
TUYA_CLOUD_ACCESS_SECRET=

# Region for the Tuya Cloud OpenAPI: us | eu | cn | in
TUYA_CLOUD_REGION=us

# JDBC URL for H2 file-mode DB (default is fine for local use)
DB_URL=jdbc:h2:file:./data/tuya
